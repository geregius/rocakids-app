rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Foto de perfil de un servidor: cualquiera autenticado puede verla
    // (directorio interno de staff), pero solo el propio dueño puede
    // subir/reemplazar la suya. Límite de 5MB y solo imágenes.
    match /servidores_fotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
