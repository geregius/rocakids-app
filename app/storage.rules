rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Foto de perfil de un servidor: cualquiera autenticado puede verla
    // (directorio interno de staff), pero solo el propio dueño puede
    // subir/reemplazar la suya. Límite de 5MB y solo imágenes.
    match /servidores_fotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Foto de seguridad del acudiente (para validar retiro del niño).
    // Solo el propio dueño puede subirla/reemplazarla.
    match /acudientes_fotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Foto del niño: cualquier autenticado puede subirla, pero solo la
    // PRIMERA vez (resource == null → todavía no existe nada en esa ruta).
    // Igual que el registro del niño en Firestore, no se puede sobre-
    // escribir desde el cliente una vez subida.
    match /ninos_fotos/{ninoId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Evidencia de "Modo emergencia" (2026-08-19): foto + firma de quien
    // retira a un niño durante una emergencia. Más sensible que el
    // resto de fotos del proyecto (rostro de alguien que puede no tener
    // ninguna cuenta en el sistema) — a propósito acotado a
    // administrador, columna y líder de ministerio (mismo criterio que
    // `puedeVerInfoLiderazgo()` en firestore.rules), no a "cualquier
    // autenticado" como el resto de rutas de este archivo. Storage no
    // puede llamar funciones de firestore.rules directamente, así que
    // el chequeo de rol se repite acá con `firestore.get()`.
    function esLiderazgoRocaKids() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid))
             .data.rol.lower() in ['administrador', 'columna', 'lider_ministerio'];
    }

    match /emergencia_fotos/{registroId}/{fileName} {
      allow read: if esLiderazgoRocaKids();
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /emergencia_firmas/{registroId}/{fileName} {
      allow read: if esLiderazgoRocaKids();
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
