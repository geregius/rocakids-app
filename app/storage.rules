rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Foto de perfil de un servidor: cualquiera autenticado puede verla
    // (directorio interno de staff), pero solo el propio dueño puede
    // subir/reemplazar la suya. Límite de 5MB y solo imágenes.
    match /servidores_fotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Foto de seguridad del acudiente (para validar retiro del niño).
    // Solo el propio dueño puede subirla/reemplazarla.
    match /acudientes_fotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Foto del niño: cualquier autenticado puede subirla, pero solo la
    // PRIMERA vez (resource == null → todavía no existe nada en esa ruta).
    // Igual que el registro del niño en Firestore, no se puede sobre-
    // escribir desde el cliente una vez subida.
    match /ninos_fotos/{ninoId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
