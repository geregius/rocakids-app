rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Foto de perfil de un servidor: cualquiera autenticado puede verla
    // (directorio interno de staff), pero solo el propio dueño puede
    // subir/reemplazar la suya. Límite de 5MB y solo imágenes.
    match /servidores_fotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Foto de seguridad del acudiente (para validar retiro del niño).
    // Solo el propio dueño puede subirla/reemplazarla.
    match /acudientes_fotos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Foto del niño: cualquier autenticado puede subirla, pero solo la
    // PRIMERA vez (resource == null → todavía no existe nada en esa ruta).
    // Igual que el registro del niño en Firestore, no se puede sobre-
    // escribir desde el cliente una vez subida.
    match /ninos_fotos/{ninoId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Evidencia de "Modo emergencia" (2026-08-19): foto + firma de quien
    // retira a un niño durante una emergencia.
    //
    // Intento inicial: `read` acotado a admin/columna/líder de ministerio
    // vía `firestore.get()` (consulta cruzada Storage→Firestore, sintaxis
    // oficial de Firebase). **Falló en producción con
    // `storage/unauthorized` incluso para la cuenta admin** — como no
    // dependía del rol de quien llama (fallaba igual para cualquiera),
    // el problema era la función en sí, no un permiso mal calculado. Sin
    // forma de probar esa sintaxis en vivo desde esta sesión, se
    // simplificó al mismo patrón YA comprobado del resto de este archivo
    // (`servidores_fotos`/`acudientes_fotos`/`ninos_fotos`): cualquier
    // autenticado puede leer. Ver docs/estado-proyecto.md sección 5.6
    // para el detalle y la fecha de este ajuste.
    match /emergencia_fotos/{registroId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /emergencia_firmas/{registroId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
