rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol.lower() == 'administrador';
    }

    // Roles que pueden hacer entrada/salida de niños (check-in/check-out),
    // decidido por Rafael: administrador, columna, líder de ministerio,
    // líder escuela de siervos, maestro principal y maestro auxiliar.
    function puedeRegistrarAsistencia() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol.lower() in [
          'administrador', 'columna', 'lider_ministerio',
          'lider_escuela_siervos', 'maestro_principal', 'maestro_auxiliar'
        ];
    }

    // El ID de nino_acudiente es determinístico ({ninoId}_{uid}, ver
    // auth_service.dart), así que se puede consultar la relación exacta
    // de quien llama con un niño puntual con una sola lectura. Solo
    // Padre o Madre pueden editar la ficha del niño (decisión de
    // Rafael) — no cualquier acudiente autorizado.
    function esPadreOMadreDe(ninoId) {
      let relId = ninoId + '_' + request.auth.uid;
      return request.auth != null &&
        exists(/databases/$(database)/documents/nino_acudiente/$(relId)) &&
        get(/databases/$(database)/documents/nino_acudiente/$(relId)).data.parentescoTipo in ['Padre', 'Madre'];
    }

    // ninos/{ninoId}.presente se mantiene junto con cada Entrada/Salida
    // (ver AuthService.registrarMovimiento() y las Cloud Functions de
    // cierre automático) — evita que se le registre una SEGUNDA Entrada
    // a un niño que ya está presente (ni por error humano ni por dos
    // servidores registrándolo casi al mismo tiempo). `false` si el
    // campo no existe (niños creados antes de este cambio, o que nunca
    // han tenido una entrada).
    function ninoYaPresente(ninoId) {
      return get(/databases/$(database)/documents/ninos/$(ninoId)).data.get('presente', false) == true;
    }

    // Rol "de liderazgo" (2026-08-17, pedido explícito de Rafael, ampliado
    // 2026-08-18): administrador, columna y líder de ministerio — NO
    // maestros ni líder de escuela de siervos, aunque estos sí puedan
    // hacer check-in (`puedeRegistrarAsistencia()`). Controla el `list`
    // de `acudientes` (panel "Acudientes y Niños") y, desde 2026-08-18,
    // también el `list`/`get` de OTRO usuario en `usuarios` (Dashboard:
    // "servidores activos" y en general ver la ficha de un servidor) —
    // Rafael confirmó explícitamente que columna y líder de ministerio
    // sí pueden ver la información de los servidores, solo líder de
    // escuela de siervos (y el resto de roles operativos) no.
    function puedeVerInfoLiderazgo() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol.lower() in [
          'administrador', 'columna', 'lider_ministerio'
        ];
    }

    // "Programación de Servidores" (2026-08-31, pedido explícito de
    // Rafael: "solo los líderes del ministerio") — a propósito MÁS
    // ACOTADO que puedeVerInfoLiderazgo(): NO incluye columna. Debe
    // quedar sincronizado con `RolUsuario.puedeGestionarProgramacion`
    // en el cliente.
    function puedeGestionarProgramacion() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol.lower() in [
          'administrador', 'lider_ministerio'
        ];
    }

    // --- Validación de formato/tipo de datos (2026-08-21) ---
    // Todo lo de arriba valida QUIÉN puede escribir; esto valida QUÉ se
    // puede escribir. Antes de esto, `allow create` solo exigía rol/
    // sesión — cualquier cuenta válida podía crear un documento con
    // campos de cualquier tipo/formato saltándose la app Flutter (única
    // que validaba hasta ahora). Se aplica SOLO a `create` (nunca a
    // `update`, que ya tiene su propio bloqueo de campos por regla) y
    // solo a los campos con un formato conocido — deliberadamente
    // permisivo en longitud/contenido de texto libre para no rechazar
    // nunca un dato real.
    function esTexto(v) { return v is string; }
    function esTextoAcotado(v, maxLen) { return v is string && v.size() <= maxLen; }
    function esTextoNoVacioAcotado(v, maxLen) { return v is string && v.size() > 0 && v.size() <= maxLen; }

    match /usuarios/{uid} {
      // Cualquiera autenticado puede leer su propio perfil. Un admin, o
      // columna/líder de ministerio (`puedeVerInfoLiderazgo()`), puede
      // leer (y listar) el perfil de cualquiera.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow get, list: if esAdmin() || puedeVerInfoLiderazgo();

      // Auto-registro: un usuario nuevo puede crear SU PROPIO documento,
      // pero solo con uno de los dos roles "de entrada" sin privilegios:
      // "usuario_externo" (acudiente) o "pendiente" (servidor esperando
      // que un admin le asigne su rol real). Nunca puede autoasignarse
      // un rol con más permisos.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.rol in ['usuario_externo', 'pendiente']
        && esTextoNoVacioAcotado(request.resource.data.get('correo', ''), 200)
        && esTextoNoVacioAcotado(request.resource.data.get('nombre', ''), 100)
        && esTextoNoVacioAcotado(request.resource.data.get('apellido', ''), 100)
        && request.resource.data.get('activo', true) == true;

      // Un admin, o columna/líder de ministerio (`puedeVerInfoLiderazgo()`,
      // 2026-08-24, "Gestión de Servidores" — control total, mismo
      // criterio que `puedeGestionarServidores` en la app), puede editar
      // cualquier cosa. El propio dueño del perfil puede completarlo/
      // editarlo (documento, teléfono, EPS, grupo sanguíneo, contacto de
      // emergencia, foto), pero NUNCA puede cambiar su propio rol, estado
      // activo o correo por esta vía.
      allow update: if esAdmin() || puedeVerInfoLiderazgo() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.rol == resource.data.rol &&
        request.resource.data.activo == resource.data.activo &&
        request.resource.data.correo == resource.data.correo &&
        request.resource.data.get('fechaVerificacionAntecedentes', null) ==
          resource.data.get('fechaVerificacionAntecedentes', null)
      );

      allow delete: if esAdmin() || puedeVerInfoLiderazgo();
    }

    // Historial de notificaciones dentro de la app (2026-09-02, campana
    // en `AppShell`) — solo el propio dueño puede leerlas. Escritura
    // SIEMPRE desde el Admin SDK (`enviarNotificacionAUsuarios()` en
    // functions/index.js), nunca desde el cliente — la única excepción
    // es marcar como leída, y solo ESE campo (`update` que intente
    // cambiar cualquier otra cosa se rechaza).
    match /usuarios/{uid}/notificaciones/{notifId} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow create, delete: if false;
    }

    // Reserva de unicidad de documento de acudiente: doc ID = numeroDocumento.
    // Mismo truco que en ninos — un segundo intento con el mismo documento
    // cae en "update" (no permitido), así que Firestore rechaza el duplicado.
    match /acudientes_documentos/{numeroDocumento} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow get: if request.auth != null;
      allow update, delete: if esAdmin();
    }

    match /acudientes/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow get, list: if esAdmin();
      // Quien hace check-in/out necesita poder leer la ficha de CUALQUIER
      // acudiente (no solo la suya) para mostrarla y, si hace falta,
      // editarla en el momento — ver el update de abajo.
      allow get: if puedeRegistrarAsistencia();
      // `list` (traer TODA la colección) es más sensible que `get`
      // puntual — solo para el panel "Acudientes y Niños", acotado a
      // administrador/columna/líder de ministerio (2026-08-17).
      allow list: if puedeVerInfoLiderazgo();

      // Auto-registro: solo su propio documento.
      allow create: if request.auth != null && request.auth.uid == uid
        && esTextoNoVacioAcotado(request.resource.data.get('tipoDocumento', ''), 60)
        && esTextoNoVacioAcotado(request.resource.data.get('numeroDocumento', ''), 30)
        && esTextoNoVacioAcotado(request.resource.data.get('nombres', ''), 150)
        && esTextoNoVacioAcotado(request.resource.data.get('apellidos', ''), 150)
        && esTextoNoVacioAcotado(request.resource.data.get('telefonoCelular', ''), 30)
        && esTextoNoVacioAcotado(request.resource.data.get('correoElectronico', ''), 200)
        && esTextoAcotado(request.resource.data.get('fotoSeguridadUrl', ''), 1000)
        && request.resource.data.get('estadoAutorizacion', 'Autorizado') == 'Autorizado'
        && request.resource.data.get('observacionesRestriccion', '') == '';

      // El propio acudiente, un admin, o quien hace check-in/out puede
      // corregir los datos de contacto/documento de un acudiente — pero
      // nadie salvo un admin puede tocar el estado de autorización ni las
      // observaciones de restricción (seguridad).
      allow update: if esAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        request.resource.data.estadoAutorizacion == resource.data.estadoAutorizacion &&
        request.resource.data.observacionesRestriccion == resource.data.observacionesRestriccion
      ) || (
        puedeRegistrarAsistencia() &&
        request.resource.data.estadoAutorizacion == resource.data.estadoAutorizacion &&
        request.resource.data.observacionesRestriccion == resource.data.observacionesRestriccion
      );

      allow delete: if esAdmin();
    }

    match /ninos/{ninoId} {
      // El ID del documento es la "llave interna" del SOP (documento del
      // menor, o fecha+nombre+apellido si no tiene). Como Firestore
      // clasifica la operación como "create" solo si el documento AÚN NO
      // existe, esto previene duplicados: un segundo intento con el mismo
      // ID cae en "update", que aquí no está permitido para el cliente.
      allow create: if request.auth != null
        && esTextoNoVacioAcotado(request.resource.data.get('documentoIdentificacion', ''), 100)
        && request.resource.data.get('tipoIdentificacion', '') in
          ['Registro Civil', 'Tarjeta de Identidad', 'Cédula de Extranjería', 'Pasaporte', 'No tiene documento']
        && esTextoAcotado(request.resource.data.get('identificacionMenor', ''), 50)
        && esTextoNoVacioAcotado(request.resource.data.get('nombres', ''), 150)
        && esTextoNoVacioAcotado(request.resource.data.get('apellidos', ''), 150)
        && request.resource.data.get('fechaNacimiento', request.time) is timestamp
        && request.resource.data.get('genero', '') in ['Masculino', 'Femenino']
        && request.resource.data.get('estadoRegistro', '') == 'Activo'
        && request.resource.data.get('alertaMedicaFlag', false) is bool
        && esTextoAcotado(request.resource.data.get('condicionMedica', ''), 500)
        && request.resource.data.get('autorizoFotoFlag', false) is bool
        && esTextoAcotado(request.resource.data.get('fotoUrl', ''), 1000)
        && request.resource.data.get('tieneNoAutorizados', false) == false
        && request.resource.data.get('totalEntradas', 0) == 0
        && request.resource.data.get('ultimaAsistencia', null) == null;

      allow get: if request.auth != null;
      // `list` (traer TODA la colección) es más sensible que `get`
      // puntual — solo admin o quien hace check-in/out (para el panel
      // "Acudientes y Niños", pedido de Rafael para que cualquier rol de
      // servidor lo pueda ver, no solo el admin).
      allow list: if esAdmin() || puedeRegistrarAsistencia();

      // Un admin puede editar cualquier campo. El padre/madre vinculado,
      // Y TAMBIÉN quien hace check-in/out (decisión de Rafael: "para
      // facilitar el proceso"), pueden corregir los datos básicos, pero
      // NO el documento del menor (cambiarlo movería la llave primaria,
      // una migración más delicada) ni el estado de registro ni la foto.
      // Quien hace check-in/out además puede completar el documento (y
      // SOLO eso) ahí mismo si el niño no lo tenía — ver el bloqueo en
      // /registros y la rama siguiente.
      allow update: if esAdmin() || (
        (esPadreOMadreDe(ninoId) || puedeRegistrarAsistencia()) &&
        request.resource.data.tipoIdentificacion == resource.data.tipoIdentificacion &&
        request.resource.data.identificacionMenor == resource.data.identificacionMenor &&
        request.resource.data.estadoRegistro == resource.data.estadoRegistro &&
        request.resource.data.fotoUrl == resource.data.fotoUrl
      ) || (
        puedeRegistrarAsistencia() &&
        request.resource.data.nombres == resource.data.nombres &&
        request.resource.data.apellidos == resource.data.apellidos &&
        request.resource.data.fechaNacimiento == resource.data.fechaNacimiento &&
        request.resource.data.genero == resource.data.genero &&
        request.resource.data.estadoRegistro == resource.data.estadoRegistro &&
        request.resource.data.fotoUrl == resource.data.fotoUrl &&
        request.resource.data.autorizoFotoFlag == resource.data.autorizoFotoFlag &&
        request.resource.data.alertaMedicaFlag == resource.data.alertaMedicaFlag &&
        request.resource.data.condicionMedica == resource.data.condicionMedica
      ) || (
        // Liderazgo (admin/columna/líder de ministerio) puede cambiar
        // `estadoRegistro` — ej. "Inactivo" para un niño que se mudó de
        // ciudad, desde el reporte "Niños que dejaron de asistir"
        // (2026-08-21, pedido de Rafael). Nada más se puede tocar por
        // esta vía (todo lo demás queda igual) — ver
        // `AuthService.registrarGestion()`.
        puedeVerInfoLiderazgo() &&
        request.resource.data.tipoIdentificacion == resource.data.tipoIdentificacion &&
        request.resource.data.identificacionMenor == resource.data.identificacionMenor &&
        request.resource.data.fotoUrl == resource.data.fotoUrl &&
        request.resource.data.nombres == resource.data.nombres &&
        request.resource.data.apellidos == resource.data.apellidos &&
        request.resource.data.fechaNacimiento == resource.data.fechaNacimiento &&
        request.resource.data.genero == resource.data.genero &&
        request.resource.data.autorizoFotoFlag == resource.data.autorizoFotoFlag &&
        request.resource.data.alertaMedicaFlag == resource.data.alertaMedicaFlag &&
        request.resource.data.condicionMedica == resource.data.condicionMedica
      );

      allow delete: if esAdmin();
    }

    // Historial de gestión de asistencia (2026-08-21): registro interno
    // de liderazgo sobre el seguimiento hecho a un niño que dejó de
    // asistir (llamada hecha, resultado, si se marcó Inactivo por
    // mudanza, etc.) — para evidenciar que el reporte del Dashboard se
    // está gestionando de verdad, no solo mirando. Solo liderazgo
    // (`puedeVerInfoLiderazgo()`) puede crear o ver estas notas — no es
    // información que un acudiente o un maestro deba ver.
    match /ninos/{ninoId}/gestiones/{gestionId} {
      allow create: if puedeVerInfoLiderazgo()
        && request.resource.data.fkIdRegistradoPor == request.auth.uid
        && esTextoNoVacioAcotado(request.resource.data.get('nota', ''), 1000)
        && request.resource.data.get('estadoResultante', '') in ['Activo', 'Inactivo']
        && request.resource.data.get('fecha', request.time) is timestamp;
      allow get, list: if puedeVerInfoLiderazgo();
      allow update, delete: if esAdmin();
    }

    // Personas que NO deben tener contacto con un niño puntual (custodias,
    // órdenes de alejamiento, etc.) — texto libre, casi nunca vinculado a
    // una cuenta real del sistema (2026-08-21, pedido de Rafael). Solo
    // liderazgo (`puedeVerInfoLiderazgo()`) o el padre/madre vinculado
    // (`esPadreOMadreDe()`) pueden agregar/quitar entradas — NO cualquier
    // servidor, por la sensibilidad legal del dato. La lectura sí es más
    // amplia (`puedeRegistrarAsistencia()`): cualquiera que haga check-in
    // necesita ver la advertencia para no entregar al niño a esa persona.
    match /ninos/{ninoId}/no_autorizados/{entradaId} {
      allow create: if request.auth != null
        && (esAdmin() || puedeVerInfoLiderazgo() || esPadreOMadreDe(ninoId))
        && request.resource.data.fkIdRegistradoPor == request.auth.uid
        && esTextoNoVacioAcotado(request.resource.data.get('nombre', ''), 200)
        && esTextoAcotado(request.resource.data.get('documento', ''), 50)
        && esTextoAcotado(request.resource.data.get('motivo', ''), 1000);

      allow get, list: if esAdmin()
        || puedeVerInfoLiderazgo()
        || puedeRegistrarAsistencia()
        || esPadreOMadreDe(ninoId);

      allow update: if false;
      allow delete: if esAdmin() || puedeVerInfoLiderazgo() || esPadreOMadreDe(ninoId);
    }

    // Copia mínima de un niño (solo nombre y fecha de nacimiento, sin
    // foto/documento/info médica) para que cualquier cuenta logueada
    // pueda buscarlo por nombre al vincularlo, sin poder "navegar" datos
    // sensibles de niños con los que no tiene ningún vínculo real. Se
    // crea junto con ninos/{ninoId} (mismo ID) en el mismo batch.
    match /ninos_busqueda/{ninoId} {
      allow create: if request.auth != null
        && esTextoNoVacioAcotado(request.resource.data.get('nombres', ''), 150)
        && esTextoNoVacioAcotado(request.resource.data.get('apellidos', ''), 150)
        && request.resource.data.get('fechaNacimiento', request.time) is timestamp;
      allow get, list: if request.auth != null;
      // Debe quedar sincronizado con el nombre en ninos/{ninoId} — mismo
      // permiso que editar el niño en sí.
      allow update: if esAdmin() || esPadreOMadreDe(ninoId) || puedeRegistrarAsistencia();
      allow delete: if esAdmin();
    }

    match /nino_acudiente/{relId} {
      // El admin también puede crear (no solo el propio acudiente) para
      // poder migrar relaciones viejas de ID aleatorio al esquema nuevo
      // determinístico ({ninoId}_{uid}, ver esPadreOMadreDe arriba).
      // Quien hace check-in/out también puede crear el vínculo en nombre
      // de OTRO acudiente (2026-08-17) — para "Registrar familia" cuando
      // el acudiente y/o el niño YA existen, y solo falta relacionarlos.
      allow create: if request.auth != null
        && (
          request.resource.data.fk_idAcudiente == request.auth.uid ||
          esAdmin() ||
          puedeRegistrarAsistencia()
        )
        && esTextoNoVacioAcotado(request.resource.data.get('fk_idNino', ''), 100)
        && esTextoNoVacioAcotado(request.resource.data.get('fk_idAcudiente', ''), 128)
        && request.resource.data.get('parentescoTipo', '') in
          ['Padre', 'Madre', 'Tío/a', 'Abuelo/a', 'Acudiente Autorizado']
        && request.resource.data.get('autorizacionFormulario', '') in ['Sí', 'No']
        && request.resource.data.get('autorizacionImagen', '') in ['Sí', 'No']
        && request.resource.data.get('esRepresentanteLegalFlag', false) is bool;

      // Cualquier autenticado puede leer relaciones (igual que ninos y
      // ninos_busqueda) — hace falta para que quien hace check-in/out
      // pueda ver qué acudientes están autorizados a entregar/retirar a
      // CUALQUIER niño, no solo a los suyos.
      allow get, list: if request.auth != null;

      allow update: if esAdmin();
      // Un acudiente puede quitar su PROPIO vínculo con un niño (ej. lo
      // registró por equivocación como su hijo) — no borra ni al niño ni
      // al acudiente, solo esta relación. No puede tocar el vínculo de
      // OTRO acudiente por esta vía (2026-08-19, pedido de Rafael).
      allow delete: if esAdmin()
        || (request.auth != null
            && request.auth.uid == resource.data.fk_idAcudiente);
    }

    match /registros/{registroId} {
      // Entrada/salida de niños. Solo los roles de puedeRegistrarAsistencia()
      // pueden crear o consultar el historial — es información operativa
      // de seguridad, no algo que cualquier acudiente deba poder ver.
      //
      // El bloqueo por falta de documento (2026-08-14) se QUITÓ el
      // 2026-08-17 — Rafael pidió permitir el registro igual, mostrando
      // una advertencia en la UI en su lugar (no todos los niños
      // migrados del Módulo 2 van a tener documento, y en la práctica no
      // siempre se puede conseguir en el momento).
      //
      // Bloqueo explícito (pedido de Rafael, 2026-08-17): no se puede
      // registrar una Entrada para un niño que YA está presente — evita
      // duplicados. No aplica a niños visitante (no tienen doc en
      // `ninos`) ni a movimientos de Salida.
      // Una Salida de "Modo emergencia" (2026-08-19) exige además ser
      // admin/columna/líder de ministerio (`puedeVerInfoLiderazgo()`) —
      // defensa en profundidad: el cliente ya se lo exige a quien
      // ACTIVA/DESACTIVA el modo, pero cualquier servidor puede REGISTRAR
      // salidas mientras está activo (pedido de Rafael), así que la
      // condición real que hay que exigir acá es que nadie pueda marcar
      // `modalidadRegistro: 'Emergencia'` sin que el modo esté
      // realmente activo en `estado_app/emergencia`.
      allow create: if puedeRegistrarAsistencia()
        && request.resource.data.fkIdServidor == request.auth.uid
        && (
          request.resource.data.tipoMovimiento != 'Entrada'
            || request.resource.data.fkIdNino == ''
            || !ninoYaPresente(request.resource.data.fkIdNino)
        )
        && (
          request.resource.data.modalidadRegistro != 'Emergencia'
            || get(/databases/$(database)/documents/estado_app/emergencia).data.activo == true
        )
        && request.resource.data.tipoMovimiento in ['Entrada', 'Salida']
        && request.resource.data.fechaMovimiento is timestamp
        && esTexto(request.resource.data.get('fkIdNino', ''))
        && esTexto(request.resource.data.get('nombreNinoVisitante', ''))
        && esTextoNoVacioAcotado(request.resource.data.get('numeroManilla', ''), 30)
        && esTextoNoVacioAcotado(request.resource.data.get('nombreServidor', ''), 150)
        && esTexto(request.resource.data.get('fkIdAcudienteContacto', ''))
        && esTextoNoVacioAcotado(request.resource.data.get('nombreAcudienteContacto', ''), 150)
        && esTexto(request.resource.data.get('telefonoAcudienteContacto', ''))
        && esTexto(request.resource.data.get('tipoIdentificacionVisitante', ''))
        && esTexto(request.resource.data.get('documentoNinoVisitante', ''))
        && esTexto(request.resource.data.get('telefonoAcudienteVisitante', ''))
        && request.resource.data.get('alertaMedicaVisitante', false) is bool
        && esTexto(request.resource.data.get('condicionMedicaVisitante', ''))
        && request.resource.data.get('modalidadRegistro', '') in ['App', 'Automático', 'Histórico', 'Emergencia']
        && esTextoNoVacioAcotado(request.resource.data.get('servicio', ''), 60)
        && esTexto(request.resource.data.get('grupoEdad', ''))
        && esTexto(request.resource.data.get('observacion', ''));
      allow get, list: if puedeRegistrarAsistencia();
      allow update, delete: if esAdmin();
    }

    // Estado global de "Modo emergencia" (2026-08-19) — TODA la app
    // (incluidos acudientes) necesita leerlo para reaccionar en tiempo
    // real (ver `AppShell`), pero solo admin/columna/líder de ministerio
    // pueden activarlo/desactivarlo.
    match /estado_app/emergencia {
      allow get: if request.auth != null;
      allow write: if puedeVerInfoLiderazgo();
    }

    // Resumen mensual de asistencia (2026-08-19) — solo lo escribe la
    // Cloud Function `actualizarResumenMensual` (Admin SDK, no pasa por
    // estas reglas). El cliente solo necesita leerlo, para el bloque
    // "Histórico" del Dashboard — mismo permiso que el resto de datos
    // agregados del Dashboard (`puedeVerInfoLiderazgo()`).
    match /resumenes_mensuales/{mesId} {
      allow get, list: if puedeVerInfoLiderazgo();
      allow write: if false;
    }

    // Videos tutoriales de YouTube (2026-08-22, "Video Tutoriales" dentro
    // de "Manual de usuario") — solo se guarda el enlace y datos de
    // texto, el video en sí lo sigue sirviendo YouTube. Cualquier cuenta
    // logueada puede verlos (mismo criterio que el manual en PDF: no
    // expone ningún dato sensible); solo un admin puede agregar/editar/
    // borrar — Rafael copia los enlaces de YouTube él mismo.
    match /videos_tutoriales/{videoId} {
      allow get, list: if request.auth != null;
      allow create: if esAdmin()
        && esTextoNoVacioAcotado(request.resource.data.get('youtubeUrl', ''), 300)
        && esTextoNoVacioAcotado(request.resource.data.get('youtubeId', ''), 20)
        && esTextoNoVacioAcotado(request.resource.data.get('titulo', ''), 200)
        && esTextoAcotado(request.resource.data.get('descripcion', ''), 500)
        && request.resource.data.get('audiencias', []) is list;
      allow update, delete: if esAdmin();
    }

    // Grupos/equipos de "Programación de Servidores" (2026-08-31,
    // primera etapa: crear grupos por categoría y asignarles
    // integrantes — ver `puedeGestionarProgramacion()` arriba). Cerrado
    // por completo a cualquier otro rol (incluida lectura) hasta que se
    // decida si en una etapa futura cada servidor puede ver sus propios
    // grupos.
    match /grupos_servidores/{grupoId} {
      allow get, list: if puedeGestionarProgramacion();
      allow create: if puedeGestionarProgramacion()
        && esTextoNoVacioAcotado(request.resource.data.get('categoria', ''), 100)
        && esTextoNoVacioAcotado(request.resource.data.get('nombre', ''), 100)
        && request.resource.data.get('fkIdsServidores', []) is list
        && request.resource.data.get('orden', 0) is int;
      allow update, delete: if puedeGestionarProgramacion();
    }

    // Categorías de "Programación de Servidores" (2026-08-31, ajuste
    // el mismo día: Rafael pidió poder crear categorías nuevas, no solo
    // las 4 iniciales — antes `categoria` en `grupos_servidores` era
    // una lista fija validada acá mismo). Mismo permiso/alcance que
    // `grupos_servidores` — cerrado a cualquier otro rol. **2026-09-02:**
    // `tipoRotacion`/`diaSemana` (fijados al crear) y
    // `fechaReferenciaRotacion`/`grupoReferenciaId` (el punto de
    // partida de la rotación automática, fijado después vía `update`)
    // — ver `puedeGestionarProgramacion()`.
    match /categorias_programacion/{categoriaId} {
      allow get, list: if puedeGestionarProgramacion();
      allow create: if puedeGestionarProgramacion()
        && esTextoNoVacioAcotado(request.resource.data.get('nombre', ''), 100)
        && request.resource.data.get('tipoRotacion', '') in ['semanal', 'manual'];
      allow update, delete: if puedeGestionarProgramacion();
    }

    // Ocasiones programadas a mano de categorías `manual` (Casa2,
    // Ayunos) — ej. "el Casa2 del 12 de septiembre lo sirve el Grupo
    // 2" (2026-09-02, pedido de Rafael). Mismo permiso/alcance que las
    // dos colecciones de arriba.
    match /servicios_programados/{servicioId} {
      allow get, list: if puedeGestionarProgramacion();
      allow create: if puedeGestionarProgramacion()
        && esTextoNoVacioAcotado(request.resource.data.get('categoria', ''), 100)
        && request.resource.data.get('fecha', null) is timestamp
        && esTextoNoVacioAcotado(request.resource.data.get('grupoId', ''), 200);
      allow update, delete: if puedeGestionarProgramacion();
    }

    // Todo lo demás queda cerrado por defecto hasta que se definan
    // las reglas de cada módulo (campañas, etc).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
